library (piso_4bit) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("data_in") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("piso_4bit") {
    pin("clk") {
      direction : input;
      capacitance : 0.0177;
    }
    pin("load") {
      direction : input;
      capacitance : 0.0050;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.13499");
	}
	fall_constraint(scalar) {
          values("-0.12362");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.41269");
	}
	fall_constraint(scalar) {
          values("0.37098");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0042;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.48195");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.35063");
	}
      }
    }
    pin("serial_out") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.45798,1.46230,1.47354,1.50096,1.57402,1.79789,2.50719");
	}
	rise_transition(template_1) {
          values("0.02226,0.02556,0.03530,0.06465,0.16187,0.48257,1.50622");
	}
	cell_fall(template_1) {
          values("1.55455,1.55847,1.56861,1.59174,1.64585,1.79821,2.27837");
	}
	fall_transition(template_1) {
          values("0.02072,0.02333,0.03049,0.04989,0.10903,0.30671,0.94740");
	}
      }
    }
    bus("data_in") {
      bus_type : data_in;
      direction : input;
      capacitance : 0.0000;
    pin("data_in[3]") {
      direction : input;
      capacitance : 0.0047;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.08671");
	}
	fall_constraint(scalar) {
          values("-0.21723");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.11285");
	}
	fall_constraint(scalar) {
          values("0.28548");
	}
      }
    }
    pin("data_in[2]") {
      direction : input;
      capacitance : 0.0039;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.05033");
	}
	fall_constraint(scalar) {
          values("-0.19946");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.07648");
	}
	fall_constraint(scalar) {
          values("0.26776");
	}
      }
    }
    pin("data_in[1]") {
      direction : input;
      capacitance : 0.0039;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.07349");
	}
	fall_constraint(scalar) {
          values("-0.21428");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.09966");
	}
	fall_constraint(scalar) {
          values("0.28250");
	}
      }
    }
    pin("data_in[0]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02231");
	}
	fall_constraint(scalar) {
          values("-0.04009");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.04783");
	}
	fall_constraint(scalar) {
          values("0.10858");
	}
      }
    }
    }
  }

}
