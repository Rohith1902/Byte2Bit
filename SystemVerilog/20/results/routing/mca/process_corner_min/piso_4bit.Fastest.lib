library (piso_4bit) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("data_in") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("piso_4bit") {
    pin("clk") {
      direction : input;
      capacitance : 0.0177;
    }
    pin("load") {
      direction : input;
      capacitance : 0.0049;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.07765");
	}
	fall_constraint(scalar) {
          values("-0.07122");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.24018");
	}
	fall_constraint(scalar) {
          values("0.21089");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.30922");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.22800");
	}
      }
    }
    pin("serial_out") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.45867,1.46192,1.47060,1.49293,1.55850,1.77259,2.48306");
	}
	rise_transition(template_1) {
          values("0.01600,0.01843,0.02621,0.05221,0.14441,0.45861,1.50049");
	}
	cell_fall(template_1) {
          values("1.55513,1.55816,1.56616,1.58484,1.63040,1.76577,2.21289");
	}
	fall_transition(template_1) {
          values("0.01541,0.01762,0.02332,0.03905,0.08872,0.26616,0.86514");
	}
      }
    }
    bus("data_in") {
      bus_type : data_in;
      direction : input;
      capacitance : 0.0000;
    pin("data_in[3]") {
      direction : input;
      capacitance : 0.0047;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.04406");
	}
	fall_constraint(scalar) {
          values("-0.09129");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.05840");
	}
	fall_constraint(scalar) {
          values("0.13164");
	}
      }
    }
    pin("data_in[2]") {
      direction : input;
      capacitance : 0.0039;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.01992");
	}
	fall_constraint(scalar) {
          values("-0.07946");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.03429");
	}
	fall_constraint(scalar) {
          values("0.11984");
	}
      }
    }
    pin("data_in[1]") {
      direction : input;
      capacitance : 0.0039;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.03466");
	}
	fall_constraint(scalar) {
          values("-0.08960");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.04901");
	}
	fall_constraint(scalar) {
          values("0.12985");
	}
      }
    }
    pin("data_in[0]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.00107");
	}
	fall_constraint(scalar) {
          values("-0.01408");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.01538");
	}
	fall_constraint(scalar) {
          values("0.05433");
	}
      }
    }
    }
  }

}
