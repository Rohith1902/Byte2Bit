library (piso_4bit) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("data_in") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("piso_4bit") {
    pin("clk") {
      direction : input;
      capacitance : 0.0178;
    }
    pin("load") {
      direction : input;
      capacitance : 0.0051;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.28848");
	}
	fall_constraint(scalar) {
          values("-0.31708");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.98634");
	}
	fall_constraint(scalar) {
          values("0.92619");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0043;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.94880");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.68101");
	}
      }
    }
    pin("serial_out") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.45623,1.46531,1.49045,1.55693,1.75759,2.46506,5.01923");
	}
	rise_transition(template_1) {
          values("0.03926,0.04587,0.06711,0.13828,0.40708,1.40249,4.99566");
	}
	cell_fall(template_1) {
          values("1.55328,1.56081,1.58304,1.63905,1.79543,2.33139,4.25905");
	}
	fall_transition(template_1) {
          values("0.03439,0.03976,0.05696,0.10974,0.30110,1.02105,3.64341");
	}
      }
    }
    bus("data_in") {
      bus_type : data_in;
      direction : input;
      capacitance : 0.0000;
    pin("data_in[3]") {
      direction : input;
      capacitance : 0.0048;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.20805");
	}
	fall_constraint(scalar) {
          values("-0.59262");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.26808");
	}
	fall_constraint(scalar) {
          values("0.77152");
	}
      }
    }
    pin("data_in[2]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.14401");
	}
	fall_constraint(scalar) {
          values("-0.55526");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.20405");
	}
	fall_constraint(scalar) {
          values("0.73428");
	}
      }
    }
    pin("data_in[1]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.18483");
	}
	fall_constraint(scalar) {
          values("-0.58433");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.24385");
	}
	fall_constraint(scalar) {
          values("0.76348");
	}
      }
    }
    pin("data_in[0]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.09730");
	}
	fall_constraint(scalar) {
          values("-0.17415");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.15361");
	}
	fall_constraint(scalar) {
          values("0.35388");
	}
      }
    }
    }
  }

}
