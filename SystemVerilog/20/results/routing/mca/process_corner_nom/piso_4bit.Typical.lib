library (piso_4bit) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("data_in") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("piso_4bit") {
    pin("clk") {
      direction : input;
      capacitance : 0.0183;
    }
    pin("load") {
      direction : input;
      capacitance : 0.0051;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.13708");
	}
	fall_constraint(scalar) {
          values("-0.12475");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.41474");
	}
	fall_constraint(scalar) {
          values("0.37246");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0042;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.48468");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.35168");
	}
      }
    }
    pin("serial_out") {
      direction : output;
      capacitance : 0.0012;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47503,1.47934,1.49058,1.51800,1.59105,1.81485,2.52400");
	}
	rise_transition(template_1) {
          values("0.02225,0.02557,0.03530,0.06466,0.16188,0.48249,1.50606");
	}
	cell_fall(template_1) {
          values("1.56979,1.57371,1.58386,1.60699,1.66109,1.81346,2.29364");
	}
	fall_transition(template_1) {
          values("0.02072,0.02332,0.03049,0.04989,0.10903,0.30671,0.94742");
	}
      }
    }
    bus("data_in") {
      bus_type : data_in;
      direction : input;
      capacitance : 0.0000;
    pin("data_in[3]") {
      direction : input;
      capacitance : 0.0049;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.09087");
	}
	fall_constraint(scalar) {
          values("-0.21799");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.11707");
	}
	fall_constraint(scalar) {
          values("0.28626");
	}
      }
    }
    pin("data_in[2]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.05199");
	}
	fall_constraint(scalar) {
          values("-0.19872");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.07817");
	}
	fall_constraint(scalar) {
          values("0.26702");
	}
      }
    }
    pin("data_in[1]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.07873");
	}
	fall_constraint(scalar) {
          values("-0.21584");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.10493");
	}
	fall_constraint(scalar) {
          values("0.28407");
	}
      }
    }
    pin("data_in[0]") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02240");
	}
	fall_constraint(scalar) {
          values("-0.03875");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.04795");
	}
	fall_constraint(scalar) {
          values("0.10724");
	}
      }
    }
    }
  }

}
