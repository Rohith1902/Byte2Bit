library (piso_4bit) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("data_in") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("piso_4bit") {
    pin("clk") {
      direction : input;
      capacitance : 0.0187;
    }
    pin("load") {
      direction : input;
      capacitance : 0.0052;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.14019");
	}
	fall_constraint(scalar) {
          values("-0.12669");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.41738");
	}
	fall_constraint(scalar) {
          values("0.37443");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0043;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.48662");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.35216");
	}
      }
    }
    pin("serial_out") {
      direction : output;
      capacitance : 0.0012;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48713,1.49144,1.50267,1.53009,1.60314,1.82691,2.53597");
	}
	rise_transition(template_1) {
          values("0.02225,0.02557,0.03531,0.06467,0.16188,0.48244,1.50597");
	}
	cell_fall(template_1) {
          values("1.58077,1.58470,1.59486,1.61799,1.67208,1.82445,2.30463");
	}
	fall_transition(template_1) {
          values("0.02072,0.02332,0.03049,0.04989,0.10902,0.30671,0.94743");
	}
      }
    }
    bus("data_in") {
      bus_type : data_in;
      direction : input;
      capacitance : 0.0000;
    pin("data_in[3]") {
      direction : input;
      capacitance : 0.0049;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.09404");
	}
	fall_constraint(scalar) {
          values("-0.21862");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.12030");
	}
	fall_constraint(scalar) {
          values("0.28688");
	}
      }
    }
    pin("data_in[2]") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.05379");
	}
	fall_constraint(scalar) {
          values("-0.19840");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.07999");
	}
	fall_constraint(scalar) {
          values("0.26672");
	}
      }
    }
    pin("data_in[1]") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.08058");
	}
	fall_constraint(scalar) {
          values("-0.21589");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.10679");
	}
	fall_constraint(scalar) {
          values("0.28414");
	}
      }
    }
    pin("data_in[0]") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02304");
	}
	fall_constraint(scalar) {
          values("-0.03797");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.04862");
	}
	fall_constraint(scalar) {
          values("0.10646");
	}
      }
    }
    }
  }

}
