library (piso_4bit) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("data_in") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("piso_4bit") {
    pin("clk") {
      direction : input;
      capacitance : 0.0188;
    }
    pin("load") {
      direction : input;
      capacitance : 0.0053;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.29779");
	}
	fall_constraint(scalar) {
          values("-0.32437");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.99578");
	}
	fall_constraint(scalar) {
          values("0.93441");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0044;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.95677");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.68245");
	}
      }
    }
    pin("serial_out") {
      direction : output;
      capacitance : 0.0012;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48498,1.49405,1.51922,1.58566,1.78631,2.49378,5.04793");
	}
	rise_transition(template_1) {
          values("0.03928,0.04588,0.06708,0.13828,0.40706,1.40273,4.99625");
	}
	cell_fall(template_1) {
          values("1.57925,1.58672,1.60894,1.66495,1.82133,2.35726,4.28561");
	}
	fall_transition(template_1) {
          values("0.03440,0.03976,0.05698,0.10975,0.30111,1.02110,3.64409");
	}
      }
    }
    bus("data_in") {
      bus_type : data_in;
      direction : input;
      capacitance : 0.0000;
    pin("data_in[3]") {
      direction : input;
      capacitance : 0.0050;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.22347");
	}
	fall_constraint(scalar) {
          values("-0.59682");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.28252");
	}
	fall_constraint(scalar) {
          values("0.77582");
	}
      }
    }
    pin("data_in[2]") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.15104");
	}
	fall_constraint(scalar) {
          values("-0.55481");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.21016");
	}
	fall_constraint(scalar) {
          values("0.73396");
	}
      }
    }
    pin("data_in[1]") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.19821");
	}
	fall_constraint(scalar) {
          values("-0.58974");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.25719");
	}
	fall_constraint(scalar) {
          values("0.76901");
	}
      }
    }
    pin("data_in[0]") {
      direction : input;
      capacitance : 0.0042;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.09918");
	}
	fall_constraint(scalar) {
          values("-0.17236");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.15555");
	}
	fall_constraint(scalar) {
          values("0.35210");
	}
      }
    }
    }
  }

}
