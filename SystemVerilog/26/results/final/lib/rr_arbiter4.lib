	cell_rise(template_1) {
          values("0.75768,0.76200,0.77325,0.80069,0.87375,1.09776,1.80741");
	}
	rise_transition(template_1) {
          values("0.02226,0.02555,0.03530,0.06462,0.16185,0.48275,1.50657");
	}
	cell_fall(template_1) {
