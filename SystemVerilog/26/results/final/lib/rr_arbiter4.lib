	}
	cell_fall(template_1) {
          values("0.76304,0.76784,0.77812,0.79916,0.84451,0.96062,1.29496");
	}
	fall_transition(template_1) {
          values("0.01775,0.02061,0.02791,0.04575,0.09392,0.24240,0.69510");
	}
      }
