library (lfsr) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("lfsr") {
    pin("clk") {
      direction : input;
      capacitance : 0.0148;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0039;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.29773");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17112");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48095,1.48426,1.49302,1.51538,1.58089,1.79549,2.50635");
	}
	rise_transition(template_1) {
          values("0.01659,0.01900,0.02666,0.05240,0.14439,0.45862,1.50287");
	}
	cell_fall(template_1) {
          values("1.56678,1.56980,1.57778,1.59646,1.64204,1.77743,2.22467");
	}
	fall_transition(template_1) {
          values("0.01542,0.01766,0.02328,0.03905,0.08872,0.26586,0.86381");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.44820,1.45147,1.46019,1.48254,1.54808,1.76239,2.47304");
	}
	rise_transition(template_1) {
          values("0.01626,0.01868,0.02641,0.05230,0.14440,0.45862,1.50155");
	}
	cell_fall(template_1) {
          values("1.53995,1.54297,1.55096,1.56964,1.61521,1.75060,2.19777");
	}
	fall_transition(template_1) {
          values("0.01542,0.01764,0.02330,0.03905,0.08872,0.26601,0.86448");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47527,1.47857,1.48732,1.50968,1.57520,1.78971,2.50052");
	}
	rise_transition(template_1) {
          values("0.01650,0.01891,0.02659,0.05237,0.14439,0.45862,1.50249");
	}
	cell_fall(template_1) {
          values("1.56244,1.56546,1.57344,1.59212,1.63770,1.77309,2.22032");
	}
	fall_transition(template_1) {
          values("0.01542,0.01765,0.02328,0.03905,0.08872,0.26589,0.86396");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.85408,1.85732,1.86602,1.88835,1.95392,2.16805,2.87855");
	}
	rise_transition(template_1) {
          values("0.01605,0.01848,0.02625,0.05223,0.14441,0.45861,1.50070");
	}
	cell_fall(template_1) {
          values("1.47044,1.47348,1.48150,1.50017,1.54572,1.68106,2.12802");
	}
	fall_transition(template_1) {
          values("0.01540,0.01758,0.02336,0.03906,0.08871,0.26653,0.86677");
	}
      }
    }
    }
  }

}
