library (lfsr) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("lfsr") {
    pin("clk") {
      direction : input;
      capacitance : 0.0149;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.92143");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.48562");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47743,1.48647,1.51170,1.57805,1.77870,2.48615,5.04027");
	}
	rise_transition(template_1) {
          values("0.03932,0.04589,0.06703,0.13829,0.40701,1.40325,4.99752");
	}
	cell_fall(template_1) {
          values("1.56417,1.57151,1.59372,1.64971,1.80610,2.34198,4.27173");
	}
	fall_transition(template_1) {
          values("0.03442,0.03977,0.05701,0.10977,0.30113,1.02120,3.64550");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.44713,1.45620,1.48137,1.54780,1.74846,2.45592,5.01007");
	}
	rise_transition(template_1) {
          values("0.03929,0.04588,0.06708,0.13828,0.40706,1.40278,4.99639");
	}
	cell_fall(template_1) {
          values("1.53914,1.54660,1.56882,1.62483,1.78122,2.31714,4.24557");
	}
	fall_transition(template_1) {
          values("0.03440,0.03976,0.05698,0.10975,0.30111,1.02110,3.64417");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47152,1.48057,1.50578,1.57216,1.77281,2.48026,5.03439");
	}
	rise_transition(template_1) {
          values("0.03931,0.04589,0.06705,0.13829,0.40702,1.40312,4.99722");
	}
	cell_fall(template_1) {
          values("1.55965,1.56702,1.58923,1.64523,1.80162,2.33751,4.26690");
	}
	fall_transition(template_1) {
          values("0.03442,0.03977,0.05700,0.10977,0.30113,1.02117,3.64514");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.85258,1.86166,1.88679,1.95329,2.15394,2.86142,5.41559");
	}
	rise_transition(template_1) {
          values("0.03926,0.04587,0.06711,0.13828,0.40709,1.40244,4.99554");
	}
	cell_fall(template_1) {
          values("1.46925,1.47698,1.49923,1.55527,1.71164,2.24768,4.17312");
	}
	fall_transition(template_1) {
          values("0.03436,0.03975,0.05692,0.10971,0.30107,1.02088,3.64119");
	}
      }
    }
    }
  }

}
