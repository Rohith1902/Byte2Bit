library (lfsr) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("lfsr") {
    pin("clk") {
      direction : input;
      capacitance : 0.0155;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.92607");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.48848");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.49288,1.50191,1.52716,1.59348,1.79414,2.50158,5.05569");
	}
	rise_transition(template_1) {
          values("0.03933,0.04590,0.06702,0.13829,0.40700,1.40338,4.99784");
	}
	cell_fall(template_1) {
          values("1.57816,1.58547,1.60768,1.66366,1.82006,2.35592,4.28606");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05702,0.10978,0.30114,1.02123,3.64589");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.46038,1.46944,1.49462,1.56104,1.76169,2.46915,5.02329");
	}
	rise_transition(template_1) {
          values("0.03929,0.04588,0.06707,0.13829,0.40705,1.40288,4.99663");
	}
	cell_fall(template_1) {
          values("1.55124,1.55867,1.58089,1.63689,1.79328,2.32920,4.25791");
	}
	fall_transition(template_1) {
          values("0.03441,0.03977,0.05699,0.10976,0.30112,1.02112,3.64446");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48684,1.49588,1.52111,1.58746,1.78812,2.49556,5.04968");
	}
	rise_transition(template_1) {
          values("0.03932,0.04590,0.06703,0.13829,0.40701,1.40325,4.99753");
	}
	cell_fall(template_1) {
          values("1.57355,1.58089,1.60310,1.65909,1.81549,2.35136,4.28113");
	}
	fall_transition(template_1) {
          values("0.03442,0.03977,0.05701,0.10977,0.30113,1.02120,3.64552");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.86500,1.87408,1.89923,1.96570,2.16636,2.87383,5.42800");
	}
	rise_transition(template_1) {
          values("0.03927,0.04587,0.06710,0.13828,0.40708,1.40252,4.99575");
	}
	cell_fall(template_1) {
          values("1.48003,1.48774,1.50999,1.56603,1.72239,2.25843,4.18409");
	}
	fall_transition(template_1) {
          values("0.03436,0.03975,0.05692,0.10971,0.30107,1.02090,3.64141");
	}
      }
    }
    }
  }

}
