library (lfsr) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("lfsr") {
    pin("clk") {
      direction : input;
      capacitance : 0.0154;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.46820");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.25628");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.49563,1.49992,1.51113,1.53852,1.61155,1.83502,2.54335");
	}
	rise_transition(template_1) {
          values("0.02224,0.02561,0.03531,0.06474,0.16192,0.48206,1.50520");
	}
	cell_fall(template_1) {
          values("1.57999,1.58393,1.59415,1.61727,1.67133,1.82372,2.30395");
	}
	fall_transition(template_1) {
          values("0.02072,0.02330,0.03049,0.04989,0.10900,0.30672,0.94752");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.46128,1.46558,1.47681,1.50422,1.57726,1.80096,2.50984");
	}
	rise_transition(template_1) {
          values("0.02225,0.02558,0.03531,0.06469,0.16189,0.48235,1.50578");
	}
	cell_fall(template_1) {
          values("1.55187,1.55579,1.56596,1.58909,1.64318,1.79555,2.27574");
	}
	fall_transition(template_1) {
          values("0.02072,0.02332,0.03049,0.04989,0.10902,0.30671,0.94744");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48979,1.49408,1.50530,1.53269,1.60573,1.82925,2.53773");
	}
	rise_transition(template_1) {
          values("0.02224,0.02560,0.03531,0.06473,0.16191,0.48214,1.50535");
	}
	cell_fall(template_1) {
          values("1.57554,1.57947,1.58968,1.61280,1.66687,1.81926,2.29947");
	}
	fall_transition(template_1) {
          values("0.02072,0.02330,0.03049,0.04989,0.10900,0.30671,0.94750");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.86622,1.87054,1.88178,1.90920,1.98225,2.20609,2.91532");
	}
	rise_transition(template_1) {
          values("0.02225,0.02557,0.03530,0.06466,0.16188,0.48253,1.50614");
	}
	cell_fall(template_1) {
          values("1.48098,1.48488,1.49498,1.51812,1.57227,1.72456,2.20456");
	}
	fall_transition(template_1) {
          values("0.02071,0.02333,0.03049,0.04991,0.10908,0.30673,0.94833");
	}
      }
    }
    }
  }

}
