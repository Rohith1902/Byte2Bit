library (lfsr) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("lfsr") {
    pin("clk") {
      direction : input;
      capacitance : 0.0154;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.29976");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17262");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.49662,1.49995,1.50872,1.53109,1.59658,1.81127,2.52221");
	}
	rise_transition(template_1) {
          values("0.01670,0.01910,0.02673,0.05243,0.14438,0.45862,1.50328");
	}
	cell_fall(template_1) {
          values("1.58093,1.58395,1.59193,1.61061,1.65619,1.79158,2.23886");
	}
	fall_transition(template_1) {
          values("0.01542,0.01766,0.02328,0.03905,0.08873,0.26583,0.86373");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.46162,1.46490,1.47363,1.49598,1.56151,1.77589,2.48658");
	}
	rise_transition(template_1) {
          values("0.01634,0.01876,0.02646,0.05232,0.14440,0.45862,1.50184");
	}
	cell_fall(template_1) {
          values("1.55217,1.55520,1.56318,1.58186,1.62744,1.76282,2.21002");
	}
	fall_transition(template_1) {
          values("0.01542,0.01765,0.02329,0.03905,0.08872,0.26595,0.86425");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.49087,1.49418,1.50294,1.52530,1.59081,1.80541,2.51628");
	}
	rise_transition(template_1) {
          values("0.01660,0.01901,0.02666,0.05240,0.14439,0.45862,1.50288");
	}
	cell_fall(template_1) {
          values("1.57654,1.57956,1.58754,1.60622,1.65180,1.78719,2.23444");
	}
	fall_transition(template_1) {
          values("0.01542,0.01766,0.02328,0.03905,0.08872,0.26585,0.86380");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.86670,1.86995,1.87865,1.90099,1.96655,2.18074,2.89128");
	}
	rise_transition(template_1) {
          values("0.01611,0.01854,0.02630,0.05225,0.14440,0.45861,1.50096");
	}
	cell_fall(template_1) {
          values("1.48137,1.48441,1.49242,1.51110,1.55665,1.69200,2.13897");
	}
	fall_transition(template_1) {
          values("0.01541,0.01759,0.02336,0.03906,0.08871,0.26649,0.86662");
	}
      }
    }
    }
  }

}
