library (johnson_counter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("johnson_counter") {
    pin("clk") {
      direction : input;
      capacitance : 0.0172;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0039;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.30295");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.21894");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.51457,1.51791,1.52668,1.54906,1.61454,1.82928,2.54025");
	}
	rise_transition(template_1) {
          values("0.01675,0.01916,0.02678,0.05245,0.14438,0.45862,1.50350");
	}
	cell_fall(template_1) {
          values("1.59804,1.60106,1.60904,1.62772,1.67330,1.80869,2.25599");
	}
	fall_transition(template_1) {
          values("0.01543,0.01767,0.02329,0.03905,0.08873,0.26583,0.86372");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47645,1.47974,1.48847,1.51081,1.57635,1.79073,2.50143");
	}
	rise_transition(template_1) {
          values("0.01634,0.01876,0.02647,0.05232,0.14440,0.45862,1.50186");
	}
	cell_fall(template_1) {
          values("1.56664,1.56967,1.57765,1.59633,1.64191,1.77729,2.22449");
	}
	fall_transition(template_1) {
          values("0.01542,0.01765,0.02329,0.03905,0.08872,0.26595,0.86424");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.50626,1.50959,1.51835,1.54072,1.60622,1.82089,2.53181");
	}
	rise_transition(template_1) {
          values("0.01668,0.01909,0.02672,0.05242,0.14439,0.45862,1.50320");
	}
	cell_fall(template_1) {
          values("1.59080,1.59382,1.60180,1.62048,1.66606,1.80145,2.24872");
	}
	fall_transition(template_1) {
          values("0.01542,0.01766,0.02328,0.03905,0.08873,0.26584,0.86373");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47531,1.47859,1.48732,1.50967,1.57521,1.78960,2.50031");
	}
	rise_transition(template_1) {
          values("0.01636,0.01878,0.02648,0.05233,0.14440,0.45862,1.50193");
	}
	cell_fall(template_1) {
          values("1.56540,1.56843,1.57641,1.59509,1.64067,1.77605,2.22326");
	}
	fall_transition(template_1) {
          values("0.01542,0.01765,0.02329,0.03905,0.08872,0.26594,0.86419");
	}
      }
    }
    }
  }

}
