library (johnson_counter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("johnson_counter") {
    pin("clk") {
      direction : input;
      capacitance : 0.0173;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.93564");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.65861");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.51079,1.51982,1.54507,1.61139,1.81204,2.51948,5.07359");
	}
	rise_transition(template_1) {
          values("0.03934,0.04590,0.06701,0.13829,0.40699,1.40345,4.99802");
	}
	cell_fall(template_1) {
          values("1.59525,1.60254,1.62474,1.68073,1.83713,2.37298,4.30332");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05702,0.10978,0.30114,1.02125,3.64610");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47420,1.48326,1.50845,1.57486,1.77551,2.48297,5.03711");
	}
	rise_transition(template_1) {
          values("0.03929,0.04588,0.06707,0.13829,0.40705,1.40289,4.99665");
	}
	cell_fall(template_1) {
          values("1.56495,1.57238,1.59460,1.65060,1.80699,2.34290,4.27163");
	}
	fall_transition(template_1) {
          values("0.03441,0.03977,0.05699,0.10976,0.30112,1.02112,3.64448");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.50254,1.51157,1.53681,1.60315,1.80380,2.51124,5.06536");
	}
	rise_transition(template_1) {
          values("0.03933,0.04590,0.06702,0.13829,0.40700,1.40335,4.99779");
	}
	cell_fall(template_1) {
          values("1.58805,1.59536,1.61757,1.67355,1.82995,2.36581,4.29588");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05702,0.10978,0.30114,1.02122,3.64582");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.47383,1.48289,1.50808,1.57449,1.77514,2.48260,5.03674");
	}
	rise_transition(template_1) {
          values("0.03930,0.04589,0.06707,0.13829,0.40704,1.40292,4.99671");
	}
	cell_fall(template_1) {
          values("1.56429,1.57172,1.59393,1.64994,1.80632,2.34224,4.27104");
	}
	fall_transition(template_1) {
          values("0.03441,0.03977,0.05699,0.10976,0.30112,1.02113,3.64455");
	}
      }
    }
    }
  }

}
