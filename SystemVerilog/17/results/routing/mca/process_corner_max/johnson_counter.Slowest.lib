library (johnson_counter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("johnson_counter") {
    pin("clk") {
      direction : input;
      capacitance : 0.0183;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0041;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.94245");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.66188");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.53029,1.53931,1.56458,1.63087,1.83153,2.53896,5.09306");
	}
	rise_transition(template_1) {
          values("0.03935,0.04590,0.06700,0.13830,0.40698,1.40360,4.99839");
	}
	cell_fall(template_1) {
          values("1.61310,1.62035,1.64255,1.69853,1.85493,2.39076,4.32156");
	}
	fall_transition(template_1) {
          values("0.03444,0.03977,0.05703,0.10979,0.30115,1.02128,3.64655");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0011;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.49111,1.50016,1.52536,1.59176,1.79241,2.49987,5.05400");
	}
	rise_transition(template_1) {
          values("0.03930,0.04589,0.06706,0.13829,0.40704,1.40300,4.99692");
	}
	cell_fall(template_1) {
          values("1.58061,1.58801,1.61023,1.66623,1.82262,2.35852,4.28757");
	}
	fall_transition(template_1) {
          values("0.03441,0.03977,0.05699,0.10976,0.30112,1.02115,3.64480");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.52101,1.53004,1.55530,1.62161,1.82226,2.52970,5.08381");
	}
	rise_transition(template_1) {
          values("0.03934,0.04590,0.06701,0.13830,0.40699,1.40349,4.99812");
	}
	cell_fall(template_1) {
          values("1.60502,1.61229,1.63449,1.69048,1.84688,2.38272,4.31320");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05702,0.10978,0.30114,1.02125,3.64622");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.49040,1.49946,1.52466,1.59105,1.79170,2.49916,5.05329");
	}
	rise_transition(template_1) {
          values("0.03930,0.04589,0.06706,0.13829,0.40703,1.40302,4.99697");
	}
	cell_fall(template_1) {
          values("1.57966,1.58705,1.60927,1.66527,1.82166,2.35756,4.28667");
	}
	fall_transition(template_1) {
          values("0.03441,0.03977,0.05699,0.10976,0.30112,1.02115,3.64486");
	}
      }
    }
    }
  }

}
