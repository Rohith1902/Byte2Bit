library (johnson_counter) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("johnson_counter") {
    pin("clk") {
      direction : input;
      capacitance : 0.0166;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0040;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.93073");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.65730");
	}
      }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[3]") {
      direction : output;
      capacitance : 0.0013;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.49375,1.50279,1.52802,1.59437,1.79502,2.50247,5.05658");
	}
	rise_transition(template_1) {
          values("0.03932,0.04590,0.06703,0.13829,0.40701,1.40330,4.99766");
	}
	cell_fall(template_1) {
          values("1.57982,1.58715,1.60936,1.66535,1.82174,2.35761,4.28753");
	}
	fall_transition(template_1) {
          values("0.03443,0.03977,0.05701,0.10977,0.30114,1.02121,3.64567");
	}
      }
    }
    pin("q[2]") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.45927,1.46834,1.49351,1.55994,1.76060,2.46806,5.02221");
	}
	rise_transition(template_1) {
          values("0.03929,0.04588,0.06708,0.13828,0.40706,1.40278,4.99637");
	}
	cell_fall(template_1) {
          values("1.55133,1.55880,1.58102,1.63702,1.79341,2.32934,4.25774");
	}
	fall_transition(template_1) {
          values("0.03440,0.03976,0.05698,0.10975,0.30111,1.02110,3.64416");
	}
      }
    }
    pin("q[1]") {
      direction : output;
      capacitance : 0.0013;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.48634,1.49538,1.52061,1.58697,1.78762,2.49507,5.04919");
	}
	rise_transition(template_1) {
          values("0.03932,0.04589,0.06704,0.13829,0.40702,1.40322,4.99746");
	}
	cell_fall(template_1) {
          values("1.57336,1.58070,1.60292,1.65891,1.81530,2.35118,4.28085");
	}
	fall_transition(template_1) {
          values("0.03442,0.03977,0.05701,0.10977,0.30113,1.02120,3.64542");
	}
      }
    }
    pin("q[0]") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.45852,1.46759,1.49276,1.55919,1.75985,2.46731,5.02146");
	}
	rise_transition(template_1) {
          values("0.03929,0.04588,0.06708,0.13828,0.40705,1.40279,4.99641");
	}
	cell_fall(template_1) {
          values("1.55040,1.55786,1.58008,1.63608,1.79247,2.32839,4.25685");
	}
	fall_transition(template_1) {
          values("0.03440,0.03976,0.05698,0.10975,0.30111,1.02110,3.64420");
	}
      }
    }
    }
  }

}
